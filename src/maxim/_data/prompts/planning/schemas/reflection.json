{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["progress", "action", "confidence"],
  "properties": {
    "progress": {"enum": ["none", "partial", "substantial", "complete"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "action": {"enum": ["CONTINUE", "ADAPT", "RETRY", "ABORT", "ESCALATE"]},
    "adaptation": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

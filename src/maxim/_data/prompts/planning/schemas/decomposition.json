{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["can_execute_directly", "confidence", "reasoning"],
  "properties": {
    "can_execute_directly": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "direct_tool": {"type": ["string", "null"]},
    "direct_params": {"type": ["object", "null"]},
    "sub_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {"type": "string"},
          "tool_hint": {"type": ["string", "null"]},
          "depends_on": {"type": "array", "items": {"type": "integer"}},
          "requires_decomposition": {"type": "boolean"},
          "can_parallel": {"type": "boolean"},
          "priority": {"enum": ["critical", "high", "normal", "low"], "default": "normal"}
        }
      }
    },
    "reasoning": {"type": "string"}
  }
}

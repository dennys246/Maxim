      "PlatformWire": {
        "description": "Structured platform identity for the StatusChip.\n\nContract fix (maxim-pulse): ``DiagnoseResponse.platform`` used to be a\nstringified ``PlatformInfo`` repr (``\"PlatformInfo(os='macos', \u2026)\"``) \u2014\nuseless for display. These are the display-relevant fields, mapped from\n``doctor.platform_detect.PlatformInfo``.",
        "properties": {
          "arch": {
            "default": "",
            "title": "Arch",
            "type": "string"
          },
          "os": {
            "default": "",
            "title": "Os",

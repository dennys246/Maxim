  "info": {
    "summary": "Localhost Console backend + the OpenAPI facade contract for maxim-pulse.",
    "title": "Maxim Console",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/campaigns": {
      "get": {
        "operationId": "get_campaigns_api_campaigns_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Discoverable campaign YAMLs",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/diagnose": {
      "get": {
        "operationId": "get_diagnose_api_diagnose_get",

  "info": {
    "summary": "Localhost Console backend + the OpenAPI facade contract for maxim-pulse.",
    "title": "Maxim Console",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/diagnose": {
      "get": {
        "operationId": "get_diagnose_api_diagnose_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnoseResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Environment diagnostics",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/events/envelope": {
      "get": {
        "operationId": "get_event_envelope_api_events_envelope_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleEvent"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "WS event envelope shape (type-gen only; live stream is /ws)",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/models": {
      "get": {
        "operationId": "get_models_api_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List LLM profiles",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/probe": {
      "post": {
        "operationId": "post_probe_api_probe_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProbeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test a mesh/cloud connection",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/recall": {
      "get": {
        "operationId": "get_recall_api_recall_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecallResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What Maxim remembers about you",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/run": {
      "post": {
        "operationId": "post_run_api_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run a mode (talk/adventure/sim/rest)",
        "tags": [
          "facade"
        ]
      }
    },
    "/api/setup/cloud": {
      "post": {
        "operationId": "post_setup_cloud_api_setup_cloud_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloudSetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
